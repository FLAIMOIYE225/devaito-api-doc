[
  {
    "id": "auth-login",
    "section": "Authentification",
    "method": "POST",
    "path": "/api/login",
    "title": "Authentication",
    "isProtected": false,
    "description": "API key authentication to obtain a token",
    "parameters": [
      { "name": "email", "in": "body", "type": "string", "inputType":"email", "example": "exemple@gmail.com" },
      { "name": "password", "in": "body", "type": "string", "inputType":"password", "example": "mypassword" }
    ],
    "request": {
      "headers": { "Content-Type": "application/json", "Accept": "application/json" },
      "body": { "email": "string", "password": "string" }
    },
    "responses": {
      "200": {
        "description": "OK",
        "example": { "token": "11|abcxyz..." }
      }
    },
    "codeSamples": {
      "javascript": ["const response = await fetch('https://[shop-name].devaito.com/api/login', {", "  method: 'POST',", "  headers: {", "    'Content-Type': 'application/json',", "    'Authorization': 'Bearer sk_live_your_api_key'", "  }", "});", "const data = await response.json();"]
    }
  },
